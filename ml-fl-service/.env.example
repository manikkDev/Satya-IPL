# Engine (ml-fl-service)
PORT=8000
# Shared internal token — must match NODE_INTERNAL_TOKEN on the node services
NODE_INTERNAL_TOKEN=replace-with-the-same-random-value-used-by-node-services
# v2 feature flag — all /v2/* endpoints are 404 unless this is "1"
FEATURE_V2_RECON_V2=0
# Allow on-demand training via POST /v2/train (either name works; keep 0 in prod)
ALLOW_TRAIN=0
ALLOW_ENGINE_TRAIN=0
# Model artifacts directory (pair models, conformal, cards)
MODEL_ARTIFACT_DIR=runs/satya-linkage
# Optional verified HSN master (CSV/XLSX) — without it, rate lookups fail closed
HSN_MASTER_PATH=
# Optional IRP public-key directory for signed e-invoice QR verification
IRP_KEYS_DIR=
# Thread caps — keep at 2 inside the container
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
