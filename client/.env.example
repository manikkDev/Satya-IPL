# Satya web client — copy to .env.local for `npm run dev`.
# On Vercel, set these in Project Settings → Environment Variables (all are
# read at BUILD time, so redeploy after changing them). Use https URLs.

# Main API (records, cases, documents) — server/ service
NEXT_PUBLIC_GRAPH_API_URL=http://localhost:5002
# Copilot gateway — chatbot-backend/ service
NEXT_PUBLIC_MAIN_API_URL=http://localhost:5001
# Reconciliation engine (only used for diagnostics)
NEXT_PUBLIC_ML_API_URL=http://localhost:8000

# Optional
NEXT_PUBLIC_USE_MOCKS=0
NEXT_PUBLIC_ENABLE_ANALYTICS=0
