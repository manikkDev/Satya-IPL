PORT=5002
# Mongo: MONGO_URI or DB_URI (either). APP_DB_NAME is always applied, so an
# Atlas URI without a path does not write to the "test" database.
DB_URI=mongodb://localhost:27017/satya
MONGO_URI=
APP_DB_NAME=satya
DEMO_MODE=0
DEMO_PASSWORD=
SEED_DEMO_USERS=1
ENGINE_API_URL=http://localhost:8000
GATEWAY_API_URL=http://localhost:5001
PUBLIC_APP_URL=http://localhost:3000
BUSINESS_INVITE_CODE=
INVITE_COMPANY_ID=satya-demo
# Comma list of exact origins; a single "*" is allowed only in the first
# host label for preview deployments, e.g. https://satya-ipl-*.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=30d
# Neo4j is optional — leave NEO4J_URI empty to use snapshot/link graphs only
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NODE_INTERNAL_TOKEN=replace-with-the-same-random-value-used-by-ml-and-chatbot
# Optional directory holding hsn_master.json.gz (default: server/assets)
HSN_MASTER_PATH=
# Invite-only analyst provisioning: analysts can only register when they
# present this code plus their institution id. Leave empty to disable
# analyst self-service entirely.
ANALYST_INVITE_CODE=
# Rate limits (requests per 15-minute window)
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=1200
RATE_LIMIT_WRITES=200
MAX_UPLOAD_MB=10
# v2 feature flags: unset = ON in development, OFF when NODE_ENV=production.
# The client gates v2 screens on GET /api/v2/meta/flags.
FEATURE_V2_PO_WIZARD=1
FEATURE_V2_DOC_INBOX=1
FEATURE_V2_RECON_V2=1
FEATURE_V2_GRAPH_V2=1
FEATURE_V2_COPILOT_V2=1
FEATURE_V2_COMPLIANCE=1
FEATURE_V2_ML_V2=1
FEATURE_V2_PUBLIC_SITE_V2=1
FEATURE_V2_AI_USAGE_METER=1
