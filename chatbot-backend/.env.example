PORT=5001
NODE_ENV=development
SATYA_LLM_PROVIDER=auto
ENABLE_EXTERNAL_BUSINESS_LLM=0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
GROQ_KEY=
# Optional overrides — llama-3.1-8b-instant was decommissioned; defaults are current Groq models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
SUPABASE_URL=
SUPABASE_ANON_KEY=
JWT_SECRET=use-the-exact-same-value-as-server
ML_API_URL=http://localhost:8000
GRAPH_API_URL=http://localhost:5002
NODE_INTERNAL_TOKEN=use-the-exact-same-value-as-server-and-ml
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Satya v2 AI gateway (P0/P1-C1, C2) ---
# Comma-separated Gemini keys. NEVER commit real values — .env is gitignored.
GEMINI_API_KEYS=
# Model ladders per task (first available wins). Estimates only — verify in AI Studio.
GEMINI_MODEL_LADDER_CHAT=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_MODEL_LADDER_EXTRACT=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Per-model free-tier limits for the usage-meter estimate (rpm/rpd).
GEMINI_FREE_LIMITS_JSON=
# demo_only = free tier never sees real customer docs; paid_or_consented = consent/paid required.
AI_DATA_POLICY=demo_only
# Mongo for ai_key_state + ai_usage_daily (optional; memory-only when unset).
DB_URI=
APP_DB_NAME=satya
# Feature flags — default off in production.
FEATURE_V2_COPILOT_V2=0
FEATURE_V2_AI_USAGE_METER=0
